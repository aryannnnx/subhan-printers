# ============================================
# SUBHAN PRINTERS - XAMPP Configuration
# ============================================

APP_NAME="Subhan Printers"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080/SP



DB_HOST=localhost
DB_NAME=subhan_printers
DB_USER=root
DB_PASS=
DB_PORT=3306
DB_CHARSET=utf8mb4

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@subhanprinters.com
SMTP_FROM_NAME="Subhan Printers"
SMTP_SECURE=tls

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=subhanprinters
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

JWT_SECRET=test-secret-key-12345
ENCRYPTION_KEY=test-encryption-key

UPLOAD_MAX_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,ai,psd,cdr

ADMIN_EMAIL=admin@subhanprinters.com

CACHE_ENABLED=false
CACHE_LIFETIME=3600

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600